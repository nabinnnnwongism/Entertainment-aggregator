{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/runtime-config", "destination": "/api/runtime-config.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!assets/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
